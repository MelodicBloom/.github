{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MelodicBloom/.github/schemas/marketing-proposal.schema.json",
  "title": "MelodicBloom Marketing Interaction Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "repository",
    "source_revision",
    "generated_at",
    "status",
    "evidence",
    "audience",
    "user_need",
    "concept",
    "scope",
    "mockup_contract",
    "measurement",
    "privacy",
    "accessibility",
    "risks",
    "alternatives",
    "approval"
  ],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,79}$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_revision": {"type": "string", "minLength": 7},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["draft", "review-ready", "accepted", "rejected", "superseded"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "inferences", "unknowns", "confidence"],
      "properties": {
        "observations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "inferences": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "audience": {
      "type": "object",
      "required": ["segment", "context", "intent"],
      "properties": {
        "segment": {"type": "string"},
        "context": {"type": "string"},
        "intent": {"type": "string"},
        "exclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "user_need": {"type": "string", "minLength": 20},
    "concept": {
      "type": "object",
      "required": ["name", "summary", "value_exchange", "journey_position", "conversion_event", "mechanism"],
      "properties": {
        "name": {"type": "string"},
        "summary": {"type": "string"},
        "value_exchange": {"type": "string"},
        "journey_position": {"type": "string"},
        "conversion_event": {"type": "string"},
        "mechanism": {"type": "string"},
        "anti_patterns_forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "required": ["routes", "components", "data_contracts", "dependencies", "likely_files", "out_of_scope"],
      "properties": {
        "routes": {"type": "array", "items": {"type": "string"}},
        "components": {"type": "array", "items": {"type": "string"}},
        "data_contracts": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "likely_files": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "estimated_complexity": {"enum": ["small", "medium", "large", "unknown"]}
      }
    },
    "mockup_contract": {
      "type": "object",
      "required": ["surfaces", "states", "breakpoints", "artifact_expectation"],
      "properties": {
        "surfaces": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "states": {"type": "array", "items": {"type": "string"}, "minItems": 6},
        "breakpoints": {"type": "array", "items": {"type": "string"}, "minItems": 2},
        "artifact_expectation": {"enum": ["rendered-images", "interactive-preview", "written-spec-only"]},
        "visual_direction": {"type": "string"}
      }
    },
    "measurement": {
      "type": "object",
      "required": ["hypothesis", "primary_metric", "denominator", "quality_metric", "guardrails", "events", "stopping_conditions"],
      "properties": {
        "hypothesis": {"type": "string"},
        "primary_metric": {"type": "string"},
        "denominator": {"type": "string"},
        "quality_metric": {"type": "string"},
        "guardrails": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "events": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "stopping_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "interpretation_limits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "privacy": {
      "type": "object",
      "required": ["data_collected", "purpose", "retention", "third_parties", "consent_model"],
      "properties": {
        "data_collected": {"type": "array", "items": {"type": "string"}},
        "purpose": {"type": "string"},
        "retention": {"type": "string"},
        "third_parties": {"type": "array", "items": {"type": "string"}},
        "consent_model": {"type": "string"},
        "sensitive_data": {"type": "boolean", "const": false}
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["keyboard", "screen_reader", "focus", "reduced_motion", "error_recovery"],
      "properties": {
        "keyboard": {"type": "string"},
        "screen_reader": {"type": "string"},
        "focus": {"type": "string"},
        "reduced_motion": {"type": "string"},
        "error_recovery": {"type": "string"}
      }
    },
    "risks": {"type": "array", "items": {"type": "object", "required": ["risk", "mitigation"], "properties": {"risk": {"type": "string"}, "mitigation": {"type": "string"}}}, "minItems": 1},
    "alternatives": {"type": "array", "items": {"type": "object", "required": ["name", "reason_not_preferred"], "properties": {"name": {"type": "string"}, "reason_not_preferred": {"type": "string"}}}, "minItems": 1},
    "approval": {
      "type": "object",
      "required": ["implementation_authorized", "production_authorized", "required_review"],
      "properties": {
        "implementation_authorized": {"type": "boolean", "const": false},
        "production_authorized": {"type": "boolean", "const": false},
        "required_review": {"type": "string"},
        "decision_notes": {"type": "string"}
      }
    }
  }
}
