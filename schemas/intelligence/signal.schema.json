{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodicbloom.dev/schemas/intelligence/signal.schema.json",
  "title": "MelodicBloom Intelligence Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "title",
    "source_receipts",
    "evidence_quality",
    "novelty",
    "confidence",
    "relevance",
    "canonical_owner_candidate",
    "disposition",
    "proposed_action",
    "approval"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "signal_id": { "type": "string", "pattern": "^SIG-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 240 },
    "summary": { "type": "string", "maxLength": 2000 },
    "source_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "publication_date", "retrieved_at"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "publication_date": { "type": "string", "format": "date" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "evidence_quality": { "enum": ["high", "medium", "low", "unknown"] },
    "novelty": { "enum": ["high", "medium", "low", "duplicate"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "relevance": {
      "type": "object",
      "additionalProperties": { "enum": ["high", "medium", "low", "none"] },
      "minProperties": 1
    },
    "canonical_owner_candidate": { "type": ["string", "null"] },
    "duplicate_or_conflict_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "affected_contracts": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "disposition": {
      "enum": [
        "watch",
        "research_hypothesis",
        "architecture_candidate",
        "implementation_candidate",
        "opportunity",
        "reject_duplicate",
        "reject_low_evidence",
        "archive_context",
        "needs_human_routing"
      ]
    },
    "proposed_action": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "time_horizon": { "enum": ["immediate", "near", "medium", "long", "unspecified"] },
    "risks": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "execution_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "base_branch": { "type": "string" },
        "proposed_branch": { "type": "string" },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "evidence_to_retain": { "type": "array", "items": { "type": "string" } },
        "rollback": { "type": "string" }
      }
    },
    "analysis_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "run_id": { "type": "string" },
        "run_at": { "type": "string", "format": "date-time" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_approver"],
      "properties": {
        "status": { "enum": ["unreviewed", "approved", "rejected", "needs_revision"] },
        "required_approver": { "type": "string", "const": "Jennipher" },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "disposition": { "const": "implementation_candidate" } } },
      "then": {
        "required": ["execution_envelope"],
        "properties": {
          "evidence_quality": { "enum": ["high", "medium"] }
        }
      }
    }
  ]
}
